{
  "name": "codex-gateway",
  "version": "0.1.0",
  "description": "Personal Codex account manager and local gateway.",
  "license": "MIT",
  "author": "jadchene",
  "keywords": [
    "codex",
    "gateway",
    "electron",
    "local-first",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadchene/codex-gateway.git"
  },
  "homepage": "https://github.com/jadchene/codex-gateway#readme",
  "bugs": {
    "url": "https://github.com/jadchene/codex-gateway/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:8435 && electron .\"",
    "start": "electron .",
    "build": "vite build",
    "pack:unpacked": "npm run build && node scripts/pack-unpacked.mjs",
    "check": "node scripts/check-source.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  }
}
